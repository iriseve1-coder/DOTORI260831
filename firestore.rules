rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /calendars/{calendarId}/{document=**} {
      allow read, write: if true;
    }
    match /calendars/{calendarId} {
      allow read, write: if true;
    }
    match /events/{eventId} {
      allow read, write: if true;
    }
    match /activityLogs/{logId} {
      allow read, write: if true;
    }
  }
}
